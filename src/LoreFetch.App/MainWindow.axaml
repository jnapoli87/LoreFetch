<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LoreFetch.App.ViewModels"
        x:Class="LoreFetch.App.MainWindow"
        Title="LoreFetch"
        Width="1024" Height="768"
        MinWidth="640" MinHeight="480">
  <DockPanel>
    <!--
      Status line (A1): text comes ONLY from IScanPipeline.SourceDescription
      via code-behind — CONTRACTS.md "the status line comes from
      IScanPipeline.SourceDescription", never composed by hand here.
    -->
    <Border DockPanel.Dock="Bottom" Padding="8" Background="#1E1E1E">
      <TextBlock x:Name="StatusText"
                 Foreground="#DDDDDD"
                 FontFamily="Consolas,Menlo,monospace"
                 Text="(starting…)" />
    </Border>

    <!--
      Issue #20: the File menu. A run is one native CSV per scanning batch;
      these switch which one the window writes to. The run commands are
      disabled in code-behind when the session has no run file (Fakes mode).
      Open recent and Export are filled in code-behind: recent runs are
      listed fresh each time File opens, and exporters come from the
      session, never named here.
      HotKey (not a window KeyBinding) for Ctrl+N / Ctrl+O; the scan keys
      stay with the tunnel handler (docs/design/app.md A6 warning).
    -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="#2D2D2D">
      <MenuItem x:Name="FileMenu" Header="_File" SubmenuOpened="OnFileMenuOpened">
        <MenuItem x:Name="NewRunMenuItem" Header="_New run"
                  InputGesture="Ctrl+N" HotKey="Ctrl+N" Click="OnNewRunClick" />
        <MenuItem x:Name="OpenRunMenuItem" Header="_Open…"
                  InputGesture="Ctrl+O" HotKey="Ctrl+O" Click="OnOpenRunClick" />
        <MenuItem x:Name="RecentRunsMenuItem" Header="Open _recent" />
        <Separator />
        <MenuItem x:Name="RenameRunMenuItem" Header="Re_name run…" Click="OnRenameRunClick" />
        <MenuItem x:Name="ShowRunInFolderMenuItem" Header="_Show in folder" Click="OnShowRunInFolderClick" />
        <Separator />
        <MenuItem x:Name="ExportMenuItem" Header="_Export" />
      </MenuItem>
    </Menu>

    <!--
      A4: expected-count selector (1 / 3 / 9) and auto-capture toggle.
      DataContext is set in code-behind to a MainViewModel — never
      bound here by name, because the root window is the DataContext
      owner. RadioButton.GroupName keeps the three options mutually
      exclusive inside Avalonia's own group handling. IsDefault is
      deliberately absent on every button — Enter is the commit key in
      a later package (A7) and a default-button registration on the
      input root would intercept every Enter, even when the cohort
      grid is active (CONTRACTS.md / docs/design/app.md A6 warning).

      A10-fix bug 4: relabelled "Count:" / "1" / "3" / "9" to "Layout:" /
      "1 card" / "3 × 1" / "3 × 3" — the values written to
      ScanSettings.ExpectedCount (via IsCount1/IsCount3/IsCount9) are
      unchanged (still 1, 3, 9); only the display text changed, to say what
      each option actually looks like on the table rather than a bare count.
    -->
    <Border DockPanel.Dock="Top" Padding="8,4" Background="#2D2D2D"
            x:DataType="vm:MainViewModel">

      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Layout:" VerticalAlignment="Center" Foreground="#CCCCCC" />
        <RadioButton GroupName="ExpectedCount"
                     Content="1 card"
                     IsChecked="{Binding IsCount1, Mode=TwoWay}"
                     VerticalAlignment="Center" />
        <RadioButton GroupName="ExpectedCount"
                     Content="3 × 1"
                     IsChecked="{Binding IsCount3, Mode=TwoWay}"
                     VerticalAlignment="Center" />
        <RadioButton GroupName="ExpectedCount"
                     Content="3 × 3"
                     IsChecked="{Binding IsCount9, Mode=TwoWay}"
                     VerticalAlignment="Center" />
        <Separator Width="1" Height="20" Margin="4,0" Background="#555555" />
        <CheckBox IsChecked="{Binding AutoCaptureEnabled, Mode=TwoWay}"
                  Content="Auto"
                  VerticalAlignment="Center"
                  Foreground="#CCCCCC" />
      </StackPanel>
    </Border>

    <!--
      A9: Startup-error banner. Shown when composition signals that a
      required resource (e.g. hash index, thresholds file) is missing
      or unreadable. Driven by MainViewModel.StartupErrorMessage — set
      by code-behind or tests; never shows a stack trace. DockPanel.Dock
      Top so it appears immediately below the toolbar.
    -->
    <Border x:Name="StartupErrorBanner"
            DockPanel.Dock="Top"
            Background="#7A1111"
            Padding="8,5"
            IsVisible="{Binding HasStartupError}"
            x:DataType="vm:MainViewModel">
      <TextBlock x:Name="StartupErrorText"
                 Text="{Binding StartupErrorMessage}"
                 Foreground="White"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

    <!--
      A9: SourceFailed banner. Shown when IScanPipeline.SourceFailed fires
      (device unplugged, taken by another app, watchdog timeout). The
      message comes ONLY from FrameSourceException.Message — never a stack
      trace. Subscription/unsubscription lives in the session ctor and
      OnClosed; the handler marshals to the UI thread before setting the
      property.
    -->
    <Border x:Name="SourceErrorBanner"
            DockPanel.Dock="Top"
            Background="#7A1111"
            Padding="8,5"
            IsVisible="{Binding HasSourceError}"
            x:DataType="vm:MainViewModel">
      <TextBlock x:Name="SourceErrorText"
                 Text="{Binding SourceErrorMessage}"
                 Foreground="White"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

    <!--
      A9: Store-lock banner. Shown when Enter-commit or export throws
      CollectionStoreException (most often Excel holding the CSV open on
      Windows). The pending cohort is RETAINED (A7 contract) so the user
      can close the blocking program and click Retry. The Retry button
      re-invokes OnEnterAsync; on success the banner clears automatically.
    -->
    <Border x:Name="StoreLockBanner"
            DockPanel.Dock="Top"
            Background="#7A5511"
            Padding="8,5"
            IsVisible="{Binding HasStoreLock}"
            x:DataType="vm:MainViewModel">
      <DockPanel>
        <Button x:Name="StoreLockRetryButton"
                DockPanel.Dock="Right"
                Content="Retry"
                Click="OnStoreLockRetryClick"
                Margin="8,0,0,0" />
        <TextBlock x:Name="StoreLockText"
                   Text="{Binding StoreLockMessage}"
                   Foreground="White"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!--
      Issue #20: notice banner. Says why a File-menu action was refused or
      failed (a pending cohort, a file that isn't a run). Dismissed by hand
      and cleared by the next successful run switch.
    -->
    <Border x:Name="NoticeBanner"
            DockPanel.Dock="Top"
            Background="#24425E"
            Padding="8,5"
            IsVisible="{Binding HasNotice}"
            x:DataType="vm:MainViewModel">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Content="Dismiss"
                Click="OnNoticeDismissClick"
                Margin="8,0,0,0" />
        <TextBlock x:Name="NoticeText"
                   Text="{Binding NoticeMessage}"
                   Foreground="White"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!--
      A8: Collection DataGrid and export picker.
      DataContext is set in code-behind to a CollectionViewModel.
      Docked Bottom BEFORE the scan Grid so the scan area fills remaining space.

      Layout:
        Row 0 — header bar: run name and card count, Refresh button
        Row 1 — split: DataGrid (left) | export sidebar (right)

      The export sidebar shows a ListBox (not a ComboBox) so all items are
      always instantiated in the visual tree — which lets the visual-tree test
      confirm the "unverified" badge without opening a dropdown.

      CollectionGrid is named so visual-tree tests can find it directly.
      ExporterList is named so code-behind reads SelectedItem on export.
    -->
    <Grid DockPanel.Dock="Bottom"
          RowDefinitions="Auto, 165"
          x:Name="CollectionPanel"
          x:DataType="vm:CollectionViewModel">

      <!-- Row 0: collection header -->
      <Border Grid.Row="0"
              Background="#252525"
              Padding="8,4"
              BorderBrush="#3A3A3A"
              BorderThickness="0,1,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="Refresh"
                  Click="OnRefreshCollectionClick"
                  Margin="0,0,4,0" />
          <!-- Issue #20: names the open run and its card count. -->
          <TextBlock x:Name="CollectionHeaderText"
                     Text="{Binding HeaderText}"
                     Foreground="#AAAAAA"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- Row 1: DataGrid + export sidebar -->
      <Grid Grid.Row="1" ColumnDefinitions="*, 210">

        <!--
          Column 0: DataGrid over ICollectionStore rows.
          CanUserSortColumns="True" — DataGrid sorts natively when the column
          header is clicked; no custom sort comparer needed for simple fields.
          IsReadOnly="True" — v1 never edits rows through the UI.

          A9: EmptyCollectionHint overlays the DataGrid and is only visible
          when Rows is empty (IsEmpty=true). Grid stacking (all children
          in cell 0,0) means the DataGrid and the placeholder coexist in
          the same column; ZIndex is not needed because the DataGrid is
          transparent when empty.
        -->
        <DataGrid x:Name="CollectionGrid"
                  Grid.Column="0"
                  ItemsSource="{Binding Rows}"
                  Background="#181818"
                  RowBackground="#181818"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="False"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name"
                                Binding="{Binding OracleName}"
                                Width="*"
                                SortMemberPath="OracleName" />
            <DataGridTextColumn Header="Qty"
                                Binding="{Binding Quantity}"
                                Width="70"
                                SortMemberPath="Quantity" />
            <DataGridTextColumn Header="Condition"
                                Binding="{Binding Condition}"
                                Width="105"
                                SortMemberPath="Condition" />
            <DataGridTextColumn Header="Source"
                                Binding="{Binding Source}"
                                Width="90"
                                SortMemberPath="Source" />
            <DataGridTextColumn Header="Dist"
                                Binding="{Binding BestMatchDistance}"
                                Width="75"
                                SortMemberPath="BestMatchDistance" />
            <!--
              A10-fix bug 3: bind the LOCAL-time display projection
              (CollectionRowItem.LastScannedLocalText, "yyyy-MM-dd HH:mm:ss")
              rather than the raw CollectionRow.LastScannedAt DateTimeOffset —
              the latter renders in whatever offset it was stored with (UTC)
              formatted with the culture's default pattern, which is neither
              local nor unambiguous. The stored value itself stays UTC; only
              this column's display text changes. Width fits the fixed-width
              19-character format at this font without clipping.
            -->
            <DataGridTextColumn Header="Last Scanned"
                                Binding="{Binding LastScannedLocalText}"
                                Width="170"
                                SortMemberPath="LastScannedLocalText" />
          </DataGrid.Columns>
        </DataGrid>

        <!--
          A9: Empty-collection placeholder. Overlaid on the DataGrid
          (same Grid.Column="0") and visible only when Rows is empty.
          When rows are present the DataGrid is populated and this
          TextBlock is hidden. IsHitTestVisible="False" so it never
          intercepts clicks intended for the DataGrid.
        -->
        <TextBlock x:Name="EmptyCollectionHint"
                   Grid.Column="0"
                   Text="No cards yet — start scanning"
                   IsVisible="{Binding IsEmpty}"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#555555"
                   FontSize="13" />

        <!--
          Column 1: export picker sidebar.
          ExporterList shows one row per ICollectionExporter with a
          visible "unverified" badge on any whose IsVerified is false.
          The badge is a Border whose IsVisible is bound to IsUnverified so
          the visual-tree test can find it by walking the tree.
          No per-format code exists here — the UI iterates ExporterItems
          generically and never names any concrete exporter or format.
        -->
        <DockPanel Grid.Column="1"
                   Background="#202020"
                   LastChildFill="True">

          <!-- Export button anchored to the bottom -->
          <Button DockPanel.Dock="Bottom"
                  Content="Export…"
                  Click="OnExportClick"
                  HorizontalAlignment="Stretch"
                  Margin="8,4" />

          <!-- "Export Format" label at the top -->
          <TextBlock DockPanel.Dock="Top"
                     Text="Export Format"
                     Foreground="#888888"
                     FontSize="10"
                     Margin="8,6,8,2" />

          <!--
            ListBox (not ComboBox): all items are in the visual tree at all
            times, so the test can confirm the "unverified" badge without
            needing to open a dropdown.
          -->
          <ListBox x:Name="ExporterList"
                   ItemsSource="{Binding ExporterItems}"
                   SelectionMode="Single"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ExporterItem">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}"
                             Foreground="#CCCCCC"
                             FontSize="11"
                             VerticalAlignment="Center" />
                  <!--
                    Unverified badge: IsVisible is bound to IsUnverified on the
                    Border itself so the visual-tree test can filter on Border.IsVisible
                    (the TextBlock child does NOT duplicate the binding — searching
                    for the Border is more specific and unambiguous).
                  -->
                  <Border Background="#883333"
                          CornerRadius="2"
                          Padding="3,1"
                          IsVisible="{Binding IsUnverified}"
                          VerticalAlignment="Center">
                    <TextBlock Text="unverified"
                               Foreground="White"
                               FontSize="9" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </DockPanel>
      </Grid>
    </Grid>

    <!--
      Main content: live preview on the left, cohort grid on the right.

      A2: ONE WriteableBitmap, allocated and mutated by MainWindow.axaml.cs
      from IScanPipeline.FrameProcessed frames. Stretch="Uniform" letterboxes
      a 16:9 (or rotated) frame rather than distorting it.

      A3: quads drawn as vector children on QuadOverlayCanvas, layered over
      the Image — never baked into pixels. IsHitTestVisible="False" keeps
      the overlay from stealing input.

      A5: cohort grid on the right. The DataTemplate renders four tile
      states with per-state overlays:
        Included    — no marker
        Excluded    — dark overlay + ✕ text + grey border
        Unresolved  — red border, no name shown
        ManuallySet — blue border + M badge, distinct from a machine match
      IsLowConfidence adds an amber border on top of the Included appearance.

      #17: validating a capture means reading each tile's proposed name
      against the title printed on the card, so the cohort gets about half
      the width (the preview a bit less than before) and a GridSplitter lets
      the user move the divider. Both columns are star-sized, so they grow
      with the window; the MinWidths keep three readable names across.
    -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <!-- Column 0: preview + quad overlay -->
      <Grid Grid.Column="0">
        <Image x:Name="PreviewImage" Stretch="Uniform" />
        <Canvas x:Name="QuadOverlayCanvas" IsHitTestVisible="False" />
      </Grid>

      <!-- Column 1: draggable divider between preview and cohort -->
      <GridSplitter x:Name="CohortSplitter"
                    Grid.Column="1"
                    Width="5"
                    ResizeDirection="Columns"
                    Background="#2D2D2D" />

      <!-- Column 2: cohort grid -->
      <Border x:Name="CohortPanel" Grid.Column="2" Background="#181818" x:DataType="vm:MainViewModel">
        <ItemsControl x:Name="CohortGrid" ItemsSource="{Binding Tiles}" Padding="4"
                      VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!--
                #17: a fixed 3-column UniformGrid, so a 3 × 3 capture shows
                as 3 × 3, a 3 × 1 as one row, and a single card as one cell.
                Each cell is a third of the panel's width; the thumbnail, not
                the name, shrinks to fit the height, so all nine tiles stay
                visible without scrolling. It realises every tile (no
                virtualisation), which the visual-tree tests rely on.
              -->
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TileViewModel">
              <!--
                Tile card: the proposed name on top, the thumbnail below it.
                The name sits at the top because that is where the card's own
                printed title is, and checking one against the other is what
                the user does before Enter. Hit-test-invisible border overlays
                sit on top without intercepting clicks; A6 attaches its
                handlers to the outermost Grid, which tests find by its name.

                A6 interactions:
                  Left-click (Tapped)     → OnTileTapped → ToggleExcludedFromUi
                  Right-click ContextMenu → "Set card manually…" / "Clear"
                  AutoCompleteBox overlay → shown when IsTypeAheadOpen is true

                State visuals:
                  IsLowConfidence → amber border (on Included tiles)
                  IsUnresolved    → red border, blank DisplayName
                  IsExcluded      → grey border + dark overlay + ✕ text
                  IsManuallySet   → blue border + M badge
              -->
              <Grid x:Name="CohortTile" Margin="3"
                    Tapped="OnTileTapped">
                <!--
                  A6: Context menu — two items as specified:
                    1. "Set card manually…" → opens the type-ahead overlay (IsTypeAheadOpen = true)
                    2. "Clear"              → reverts a manual pick to the hash's own proposal
                  The Click handlers read the VM from the MenuItem's own
                  inherited DataContext (see OnTileSetManuallyClick).
                -->
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Set card manually…" Click="OnTileSetManuallyClick" />
                    <MenuItem Header="Clear" Click="OnTileClearClick" />
                  </ContextMenu>
                </Grid.ContextMenu>

                <!-- Base card background -->
                <Border Background="#2D2D2D" CornerRadius="3" />

                <DockPanel>
                  <!--
                    #17: the name strip. Large, wrapping and never trimmed —
                    a long or split name ("Sagu Wildling // Roost Seek") takes
                    more lines rather than ending in "…", because a name that
                    can't be read can't be checked.
                  -->
                  <Border DockPanel.Dock="Top" Padding="6,4"
                          Background="#CC000000" CornerRadius="3,3,0,0">
                    <StackPanel>
                      <TextBlock x:Name="TileName"
                                 Text="{Binding DisplayName}"
                                 Foreground="White" FontSize="15" FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DistanceText}"
                                 Foreground="#888888" FontSize="11" />
                    </StackPanel>
                  </Border>

                  <!--
                    Thumbnail area: fills what the name strip leaves. Uniform
                    (not UniformToFill) so the whole card shows, its printed
                    title included. Thumbnail is null in plain unit tests
                    where Avalonia is not initialised.
                  -->
                  <Grid>
                    <Image x:Name="TileThumbnail"
                           Source="{Binding Thumbnail}" Stretch="Uniform"
                           Margin="4" />

                    <!-- Excluded: dark grey overlay across the thumbnail area -->
                    <Rectangle Fill="#80000000"
                               IsVisible="{Binding IsExcluded}" />

                    <!-- Excluded: large ✕ marker centred on the thumbnail -->
                    <TextBlock Text="✕" FontSize="48" FontWeight="Bold"
                               Foreground="#CC4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding ShowExcludedMarker}" />

                    <!--
                      A9: "Set manually" hint on Unresolved tiles. Directs the
                      user to the right-click context menu so they don't
                      assume the app is broken when a card goes unrecognised.
                    -->
                    <TextBlock x:Name="SetManuallyHint"
                               Text="Right-click to set"
                               Foreground="#FF8888"
                               FontSize="12"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowSetManuallyHint}"
                               IsHitTestVisible="False" />

                    <!-- ManuallySet: "M" badge at the thumbnail's top-left -->
                    <Border Background="#2244AA" CornerRadius="2" Padding="3,1"
                            Margin="6,6,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            IsVisible="{Binding IsManuallySet}">
                      <TextBlock Text="M" Foreground="White"
                                 FontSize="11" FontWeight="Bold" />
                    </Border>
                  </Grid>
                </DockPanel>

                <!--
                  State border overlays — IsHitTestVisible="False" so
                  they never eat clicks that A6 wires to the outer Grid.
                  Only one is visible at a time (states are mutually
                  exclusive), except low-confidence which overlaps Included.
                -->
                <!-- Low-confidence: amber border (Included tiles only) -->
                <Border BorderThickness="3" CornerRadius="3"
                        BorderBrush="#FFA500"
                        IsVisible="{Binding IsLowConfidence}"
                        IsHitTestVisible="False" />
                <!-- Unresolved: red border -->
                <Border BorderThickness="3" CornerRadius="3"
                        BorderBrush="#FF4444"
                        IsVisible="{Binding IsUnresolved}"
                        IsHitTestVisible="False" />
                <!-- Excluded: grey border -->
                <Border BorderThickness="3" CornerRadius="3"
                        BorderBrush="#666666"
                        IsVisible="{Binding IsExcluded}"
                        IsHitTestVisible="False" />
                <!-- ManuallySet: blue border -->
                <Border BorderThickness="3" CornerRadius="3"
                        BorderBrush="#4488FF"
                        IsVisible="{Binding IsManuallySet}"
                        IsHitTestVisible="False" />

                <!--
                  A6: Type-ahead overlay for "Set card manually…", shown only
                  when IsTypeAheadOpen = true. It sits over the name strip at
                  the top, so the corrected name lands where the proposed one
                  was, and spans the tile's width (#18). Its dropdown popup
                  extends outside the tile. ZIndex=200 keeps it above the
                  state-border overlays.

                  MinimumPrefixLength, MinimumPopulateDelay and AsyncPopulator
                  are set in code-behind via OnTypeAheadLoaded — XAML can't
                  reliably assign the delegate-typed populator.

                  Loaded="OnTypeAheadLoaded"           — wires AsyncPopulator from TileViewModel.TypeAheadPopulator
                  SelectionChanged / DropDownClosed — pick the selected entry once the
                                                      dropdown is closed (arrowing only highlights)
                -->
                <AutoCompleteBox IsVisible="{Binding IsTypeAheadOpen}"
                                 PlaceholderText="Set card manually…"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top"
                                 ZIndex="200"
                                 Loaded="OnTypeAheadLoaded"
                                 SelectionChanged="OnTypeAheadSelectionChanged"
                                 DropDownClosed="OnTypeAheadDropDownClosed" />

              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

    </Grid>
  </DockPanel>
</Window>

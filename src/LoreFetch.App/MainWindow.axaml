<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LoreFetch.App.MainWindow"
        Title="LoreFetch"
        Width="1024" Height="768"
        MinWidth="640" MinHeight="480">
  <DockPanel>
    <!--
      Status line (A1): text comes ONLY from IScanPipeline.SourceDescription
      via code-behind — CONTRACTS.md "the status line comes from
      IScanPipeline.SourceDescription", never composed by hand here.
    -->
    <Border DockPanel.Dock="Bottom" Padding="8" Background="#1E1E1E">
      <TextBlock x:Name="StatusText"
                 Foreground="#DDDDDD"
                 FontFamily="Consolas,Menlo,monospace"
                 Text="(starting…)" />
    </Border>

    <!--
      Placeholder for the preview (A2), quad overlay (A3), expected-count
      selector (A4) and cohort grid (A5) — all later packages in this
      stream. Deliberately just a message, not a control, so there is
      nothing here that could be mistaken for a finished surface.
    -->
    <Grid>
      <TextBlock Text="Preview, overlay and cohort grid land in later packages (A2-A5)."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.6" />
    </Grid>
  </DockPanel>
</Window>

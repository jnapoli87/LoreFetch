<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LoreFetch.Capture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlashCap" />

    <!-- Decode (Cv2.ImDecode) and rotation (Cv2.Rotate); FlashCap does not
         decode MJPEG itself. -->
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoreFetch.Core\LoreFetch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Capture's internal stage is visible only to its own test project. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LoreFetch.Tests.Capture</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

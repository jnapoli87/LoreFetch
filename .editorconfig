# Formatting rules, checked on every PR by `dotnet format --verify-no-changes`
# (scripts/lorefetch.sh lint). They describe the code as it already is.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,axaml,json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.cs]
# Every file uses file-scoped namespaces; keep it that way.
csharp_style_namespace_declarations = file_scoped:warning
